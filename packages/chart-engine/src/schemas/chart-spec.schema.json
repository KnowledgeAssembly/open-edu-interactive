{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgeassemble.com/schemas/chart-spec.schema.json",
  "title": "Chart Specification",
  "description": "Canonical JSON Schema for the Chart Engine content block",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "dimensions", "measures", "data"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["bar", "line"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/idPattern" },
          "type": { "type": "string", "enum": ["ordinal", "categorical", "quantitative", "time"] }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/idPattern" },
          "type": { "type": "string", "const": "quantitative" },
          "unit": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "description": "Dynamic-key row; keys match dimension/measure ids. L2 validates key-consistency."
      }
    }
  },
  "$defs": {
    "idPattern": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$",
      "maxLength": 128
    }
  }
}