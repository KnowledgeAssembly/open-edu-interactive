{
  "type": "visual",
  "version": "1.0.0",
  "id": "coordinate-grid-practice",
  "purpose": {
    "learningObjective": "Identify points on a coordinate grid",
    "interactionGoal": "Select points on the grid",
    "reasoningMode": "identify"
  },
  "content": {
    "kind": "coordinate-grid",
    "components": [{
      "id": "cg",
      "type": "coordinate-grid",
      "props": {
        "x": { "min": -5, "max": 5, "step": 1 },
        "y": { "min": -5, "max": 5, "step": 1 },
        "interactive": true,
        "points": [
          { "x": 1, "y": 2, "id": "target" },
          { "x": -3, "y": 4, "id": "distractor-a" },
          { "x": 0, "y": -2, "id": "distractor-b" }
        ],
        "highlightPoints": ["target"]
      }
    }]
  },
  "accessibility": {
    "label": "Coordinate grid from -5 to 5",
    "description": "Select the target point at (1, 2)."
  },
  "interaction": { "mode": "identify", "actions": ["select", "focus", "deselect", "reset"] }
}