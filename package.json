{
  "name": "openedu-interactive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @knowledgeassemble/interactive-engine build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "playground": "pnpm --filter @knowledgeassemble/playground dev",
    "build:fixtures": "node scripts/build-fixture-catalog.mjs",
    "playwright": "pnpm -r --workspace-concurrency=1 playwright",
    "publish:dry": "pnpm -r publish --dry-run --no-git-checks",
    "publish:smoke": "node scripts/p7-publish-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
